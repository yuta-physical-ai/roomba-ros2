<?xml version="1.0"?>
<!-- 5 x 4 m room with furniture for LiDAR / SLAM / Nav2 tests. The robot spawns
     at the origin, which is kept clear. Physics / UserCommands / SceneBroadcaster are
     required for Fortress to step the sim, accept spawns, and feed a GUI. -->
<sdf version="1.8">
  <world name="room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- Renders the gpu_lidar. ogre2 segfaults on Jetson Orin Nano, so use ogre -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="north">
        <pose>0 2.05 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>5.2 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
      </link>
      <link name="south">
        <pose>0 -2.05 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>5.2 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
      </link>
      <link name="east">
        <pose>2.55 0 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 4.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 4.0 0.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
      </link>
      <link name="west">
        <pose>-2.55 0 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 4.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 4.0 0.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
      </link>
      <link name="partition">
        <pose>0.8 1.3 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 1.4 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 1.4 0.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <model name="sofa">
      <static>true</static>
      <link name="body">
        <pose>-1.6 1.55 0.225 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.6 0.8 0.45</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.6 0.8 0.45</size></box></geometry>
          <material><ambient>0.3 0.35 0.5 1</ambient><diffuse>0.3 0.35 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cabinet">
      <static>true</static>
      <link name="body">
        <pose>2.25 -1.2 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.5 1.0 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 1.0 0.8</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <model name="low_table">
      <static>true</static>
      <link name="top">
        <pose>-1.2 -1.2 0.415 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.8 0.5 0.03</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.5 0.03</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material></visual>
      </link>
      <link name="leg_0">
        <pose>-0.85 -1.0 0.2 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.02</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.02</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material></visual>
      </link>
      <link name="leg_1">
        <pose>-0.85 -1.4 0.2 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.02</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.02</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material></visual>
      </link>
      <link name="leg_2">
        <pose>-1.5499999999999998 -1.0 0.2 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.02</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.02</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material></visual>
      </link>
      <link name="leg_3">
        <pose>-1.5499999999999998 -1.4 0.2 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.02</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.02</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <model name="bin">
      <static>true</static>
      <link name="body">
        <pose>1.6 0.0 0.15 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
